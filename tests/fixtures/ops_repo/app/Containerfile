COPY --from=docker.io/library/busybox:1.36 /bin/sh /bin/sh
EXPOSE 80/tcp 443
ENTRYPOINT ["/app/entry.sh", "--token", "Zx9Kq2Lm8Pw4Rt6Yv1Nb3Hc5Jd7Fg0SaQe"]
CMD ["serve"]
